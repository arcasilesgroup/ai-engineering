{
  "layers": {
    "cli": "src/cli.ts",
    "commands": "src/commands/**",
    "guards": "src/guards/**",
    "chain": "src/chain/**",
    "payload": "src/payload.ts",
    "floor": "src/floor/**",
    "wrap": "src/wrap/**",
    "surfaces": "src/surfaces/**",
    "shared": "src/shared-*.ts,src/{install,receipts,embed,assets,branding,notice,theme,ui,version}.ts,src/embedded.d.ts",
    "env": "src/env.ts",
    "templates-assets": "templates/**",
    "git": "src/git/**",
    "workflow": "src/workflow/**"
  },
  "rules": [
    {
      "from": "guards",
      "mayNotImport": "chain,commands,cli"
    },
    {
      "from": "payload",
      "mayNotImport": "guards,chain,commands,cli,surfaces"
    },
    {
      "from": "commands",
      "mayNotImport": "cli"
    },
    {
      "from": "chain",
      "mayNotImport": "commands"
    },
    {
      "from": "floor",
      "mayNotImport": "commands"
    },
    {
      "from": "shared",
      "mayNotImport": "commands,guards,chain,floor,wrap,surfaces,cli"
    },
    {
      "from": "env",
      "mayNotImport": "commands,guards,chain,floor,wrap,surfaces,cli"
    },
    {
      "from": "chain",
      "mayNotImport": "surfaces"
    },
    {
      "from": "git",
      "mayNotImport": "commands,cli,chain,guards"
    },
    {
      "from": "workflow",
      "mayNotImport": "commands,cli,chain"
    },
    {
      "any": [],
      "forbid": "cycles"
    }
  ],
  "bootstrap": "allow-empty-while-files==0"
}
