{
  "name": "ai-engineering",
  "version": "2.3.0",
  "description": "Guardrails for AI coding agents: install a contract, deny destructive calls, prove every run.",
  "license": "Apache-2.0",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "ai-eng": "bin/ai-eng.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "scripts/.embed",
    "templates",
    "NOTICE.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcasilesgroup/ai-engineering.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "lint": "oxlint src tests",
    "typecheck": "oxlint --type-aware --type-check src tests",
    "arch": "bun test tests/arch.spec.ts",
    "mutation": "stryker run",
    "changeset": "changeset"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "fast-wrap-ansi": "0.2.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "7.0.2001"
  },
  "overrides": {
    "smol-toml": "1.7.2"
  },
  "optionalDependencies": {
    "ai-engineering-darwin-arm64": "2.2.3",
    "ai-engineering-darwin-x64": "2.2.3",
    "ai-engineering-linux-x64": "2.2.3",
    "ai-engineering-linux-arm64": "2.2.3",
    "ai-engineering-linux-musl-x64": "2.2.3",
    "ai-engineering-linux-musl-arm64": "2.2.3",
    "ai-engineering-windows-x64": "2.2.3",
    "ai-engineering-windows-arm64": "2.2.3"
  }
}
