Output "demo.gif"
Set Shell "bash"
Set FontSize 26
Set Width 1240
Set Height 520
Set Padding 44
Set TypingSpeed 0
Set Theme { "name": "aieng", "background": "#0B1120", "foreground": "#F8FAFB", "cursor": "#00D4AA", "selection": "#163551", "black": "#0B1120", "red": "#FF8B8B", "green": "#00D4AA", "yellow": "#E5C07B", "blue": "#61AFEF", "magenta": "#C678DD", "cyan": "#00D4AA", "white": "#F8FAFB", "brightBlack": "#5E7796", "brightRed": "#FF8B8B", "brightGreen": "#00D4AA", "brightYellow": "#E5C07B", "brightBlue": "#61AFEF", "brightMagenta": "#C678DD", "brightCyan": "#00D4AA", "brightWhite": "#F8FAFB" }
Hide
Type "bash /tmp/demo.sh"
Enter
Show
Sleep 7s
