node_modules/
dist/
# build.ts leaves an orphaned compile scratch in the cwd when it is interrupted;
# `*.bun-build` already matches the dotted names (`*` swallows the leading dot).
*.bun-build
.DS_Store
.ai-engineering/receipts/
.ai-engineering/cache/
.ai-engineering/workflow/playwright/
.claude/reviews/
# Generated, never committed: the lcov report SonarCloud reads, and the npm lockfile
# the Snyk job builds from package.json (this repository installs from bun.lock).
coverage/
package-lock.json
# Stryker's output and its sandbox: a local campaign writes both, and neither is source.
# In CI the report is an artifact, never a commit.
reports/
.stryker-tmp/
# Local review scratchpads and delta builds: CI artifacts, never source.
.audit-scratch/
.delta/
