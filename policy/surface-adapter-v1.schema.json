{
  "$defs": {
    "non_empty": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "urn:ai-engineering:surface-adapter:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "$ref": "#/$defs/non_empty"
    },
    "deny_protocol": {
      "description": "How this surface is made to deny, as an identifier a receipt can carry. The prose form is translations.reply.deny; this is the name of it, because EP-147 asks a receipt to carry the deny protocol and check-evidence's protocol_id slot is an identifier, not a sentence.",
      "pattern": "^[a-z][a-z0-9._-]*$",
      "type": "string"
    },
    "detection": {
      "additionalProperties": false,
      "properties": {
        "signal": {
          "$ref": "#/$defs/non_empty"
        },
        "undetectable_reason": {
          "$ref": "#/$defs/non_empty"
        },
        "written_by_us": {
          "const": false
        }
      },
      "required": [
        "signal",
        "written_by_us"
      ],
      "title": "detection",
      "type": "object"
    },
    "proof": {
      "additionalProperties": false,
      "description": "What an enforcement receipt must carry to count as a proof of this adapter. A machine-independent requirement on purpose: a command carries an absolute path, a payload digest carries whitespace, and neither can be compared between two machines. The receipt id can. When a superseding version of this adapter changes what a denial looks like, this id moves with it and every receipt written under the old one stops proving anything \u2014 which is the point, and is why a version bump beyond 1 must appear in the id.",
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/non_empty"
        }
      },
      "required": [
        "receipt_id"
      ],
      "title": "proof",
      "type": "object"
    },
    "schema": {
      "const": "urn:ai-engineering:surface-adapter:1"
    },
    "schema_version": {
      "const": "1"
    },
    "surface_id": {
      "enum": [
        "claude-code",
        "opencode",
        "codex-cli",
        "cursor",
        "copilot-cli",
        "vscode-copilot",
        "pi",
        "zed"
      ]
    },
    "translations": {
      "additionalProperties": false,
      "properties": {
        "exit_meaning": {
          "additionalProperties": false,
          "properties": {
            "0": {
              "enum": [
                "allow",
                "observed"
              ]
            },
            "2": {
              "enum": [
                "deny"
              ]
            }
          },
          "title": "exit_meaning",
          "type": "object"
        },
        "lifecycle_event": {
          "additionalProperties": false,
          "properties": {
            "PostToolUse": {
              "$ref": "#/$defs/non_empty"
            },
            "PreToolUse": {
              "$ref": "#/$defs/non_empty"
            },
            "SessionStart": {
              "$ref": "#/$defs/non_empty"
            },
            "Stop": {
              "$ref": "#/$defs/non_empty"
            }
          },
          "title": "lifecycle_event",
          "type": "object"
        },
        "payload_field": {
          "additionalProperties": false,
          "properties": {
            "tool_input": {
              "$ref": "#/$defs/non_empty"
            },
            "tool_name": {
              "$ref": "#/$defs/non_empty"
            },
            "tool_response": {
              "$ref": "#/$defs/non_empty"
            },
            "tool_use_id": {
              "$ref": "#/$defs/non_empty"
            }
          },
          "title": "payload_field",
          "type": "object"
        },
        "reply": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "$ref": "#/$defs/non_empty"
            },
            "deny": {
              "$ref": "#/$defs/non_empty"
            },
            "error": {
              "$ref": "#/$defs/non_empty"
            }
          },
          "title": "reply",
          "type": "object"
        }
      },
      "required": [
        "payload_field",
        "lifecycle_event",
        "exit_meaning",
        "reply"
      ],
      "title": "translations",
      "type": "object"
    },
    "trust": {
      "additionalProperties": false,
      "properties": {
        "ceremony": {
          "$ref": "#/$defs/non_empty"
        },
        "required": {
          "enum": [
            true,
            false
          ]
        }
      },
      "required": [
        "required"
      ],
      "title": "trust",
      "type": "object"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "surface_id",
    "adapter_version",
    "detection",
    "translations",
    "trust",
    "proof",
    "deny_protocol"
  ],
  "title": "One surface adapter, closed on both sides",
  "type": "object",
  "x-adapter-policy": {
    "heartbeat_is_not_declared": "installed, loaded and observed_at are read from the surface's discovery and invocation receipts. An adapter that could declare them would be the deleted `proven` flag under a longer name.",
    "missing_translation": "INCOMPLETE",
    "state_never_implies_another": true,
    "states": [
      "discovery",
      "invocation",
      "enforcement"
    ],
    "t3_enforcement": "not_applicable",
    "undetectable_is_absent": false,
    "unknown_value": "deny"
  }
}
