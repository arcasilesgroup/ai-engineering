#!/usr/bin/env bash
# Subject format, and the run receipt. It exits zero in any repository that has not
# declared itself managed, so our convention is never imposed on somebody else's fork.
set -euo pipefail
[ "$(git config --get ai.managed || echo false)" = "true" ] || exit 0

# What ran over exactly these bytes, when anything did. `PO-10` and `PO-14` ask whether
# each commit ran its module's cheap suite instead of the whole gate, and whether the
# practices the process removed stayed removed. Both were unanswerable: a gate run is a
# process, its receipts are ignored, and nothing survived into the tree to read afterwards.
#
# Absent by default. The trailer appears only when a run is on record against the same
# content this commit carries, so a commit with no trailer means nobody ran anything — which
# is the reading that matters, and the one a trailer written unconditionally would destroy.
# It is a footer and never a gate: a hook that refuses commits is a hook people escape with
# --no-verify, which rule 3 forbids and a guard blocks — the hook whose bug forces its own
# bypass.
ran_footer() {
  local ran
  ran="$(uv run python "$(git rev-parse --show-toplevel)/tests/ran_receipt.py" trailer 2>/dev/null || true)"
  [ -n "$ran" ] || return 0
  git interpret-trailers --no-divider --in-place --trailer "$ran" "$1" ||
    echo "commit-msg: the run receipt could not be placed; the commit stands." >&2
  return 0
}

subject="$(head -n1 "$1")"
# git writes these subjects itself. Refusing one strands a merge with MERGE_HEAD still
# set and kills rebase --autosquash, and the only escape a person finds is --no-verify,
# which rule 3 forbids and a guard blocks: a hook whose bug forces its own bypass.
#
# It exempts the subject rule and nothing else: a subject git chose is not a reason to
# leave the commit out of the record.
if grep -Eq '^(Merge |Revert |Reapply |fixup!|squash!|amend!)' <<<"$subject"; then
  ran_footer "$1"
  exit 0
fi
grep -Eq '^(feat|fix|docs|refactor|test|chore|ci|perf|build|revert)(\([a-z0-9./-]+\))?!?: .{1,}' <<<"$subject" || {
  echo "commit-msg: the subject must read <type>(<scope>): <what changed>, in the imperative." >&2
  exit 1
}
ran_footer "$1"
exit 0
