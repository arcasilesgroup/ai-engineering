#!/usr/bin/env bash
# Subject format, and the audit anchor. It exits zero in any repository that has not
# declared itself managed, so our convention is never imposed on somebody else's fork.
set -euo pipefail
[ "$(git config --get ai.managed || echo false)" = "true" ] || exit 0
subject="$(head -n1 "$1")"
# git writes these subjects itself. Refusing one strands a merge with MERGE_HEAD still
# set and kills rebase --autosquash, and the only escape a person finds is --no-verify,
# which rule 3 forbids and a guard blocks: a hook whose bug forces its own bypass.
if grep -Eq '^(Merge |Revert |Reapply |fixup!|squash!|amend!)' <<<"$subject"; then exit 0; fi
grep -Eq '^(feat|fix|docs|refactor|test|chore|ci|perf|build|revert)(\([a-z0-9./-]+\))?!?: .{1,}' <<<"$subject" || {
  echo "commit-msg: the subject must read <type>(<scope>): <what changed>, in the imperative." >&2
  exit 1
}
# The anchor is a footer, not a gate: if it cannot be written the commit still stands.
# A record that refuses commits is a record people delete.
#
# Only the footer is taken, and it is matched by its own shape rather than trusted to be
# the whole of stdout. `audit --anchor` sends its progress to stderr and its verdict to
# stdout, because the verdict is the data every other verb produces — so on a chain that
# does not hold, appending stdout wholesale wrote "✗ FAIL / Reason: ... / Exit code: 1"
# into the commit message. Measured, not feared: the only reason no commit here carries
# that block is that `ai.eng` pointed at a CLI too old to have the flag at all.
#
# And it says so when there is nothing to append. This was silent for three days while the
# chain sat broken and every commit went unanchored, which is the failure the record exists
# to make impossible.
AI_ENG="${AI_ENG:-$(git config --get ai.eng || echo ai-eng)}"
if command -v "${AI_ENG%% *}" >/dev/null 2>&1; then
  anchor="$($AI_ENG audit --anchor 2>/dev/null | grep -E '^Ai-Eng-Anchor: ' || true)"
  if [ -n "$anchor" ]; then
    printf '\n%s\n' "$anchor" >>"$1"
  else
    echo "commit-msg: this commit is not anchored — run \`ai-eng audit verify\`." >&2
  fi
fi
exit 0
