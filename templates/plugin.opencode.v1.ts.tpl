// ~/.config/opencode/plugins/ai-eng.ts — generated by ai-eng. LOCAL plugin, never a
// remote npm package: OpenCode installs npm plugins with Bun at boot, and
// `"plugin": ["package"]` is arbitrary third-party execution (§13). Import in-process,
// zero spawn, deny = throw.
//
// OpenCode 1.x calls every exported function of a plugin module and keeps the hooks it
// returns, so the gate is `"tool.execute.before"` / `"tool.execute.after"` — NOT the
// named `beforeToolCall`/`afterToolCall` functions 3.0.x exported, which the loader
// called as plugin factories and then failed on the hook object it expected back.
// The chain bundle lives one directory up (~/.config/opencode/ai-eng/): every file inside
// the plugin scan is imported as a plugin entry, and a bundle is not one.
import { chain } from "../ai-eng/ai-eng-chain.ts";

type Call = { tool: string; sessionID?: string; callID?: string };
type CallArgs = { args: Record<string, unknown> };
type CallResult = { output: unknown };
type AfterCall = Call & { args?: Record<string, unknown> };

export async function AiEng(host: { directory?: string } = {}) {
  // The host's workspace is the root the gate has to ask: the process may have been
  // started somewhere else entirely.
  const cwd = typeof host.directory === "string" ? host.directory : process.cwd();
  return {
    "tool.execute.before": async (call: Call, callArgs: CallArgs): Promise<void> => {
      const outcome = chain(
        "PreToolUse",
        {
          tool_name: call.tool,
          tool_input: callArgs.args,
          session_id: call.sessionID,
          tool_use_id: call.callID,
          cwd,
        },
        { surface: "opencode" },
      );
      if (outcome.action === "deny") throw new Error(`[ai-eng] ${outcome.by}: ${outcome.reason}`);
      if (outcome.action === "rewrite" && typeof callArgs.args["command"] === "string") callArgs.args["command"] = outcome.command;
    },

    "tool.execute.after": async (call: AfterCall, result: CallResult): Promise<void> => {
      const outcome = chain(
        "PostToolUse",
        {
          tool_name: call.tool,
          tool_input: call.args ?? {},
          tool_response: result.output,
          session_id: call.sessionID,
          tool_use_id: call.callID,
          cwd,
        },
        { surface: "opencode" },
      );
      if (outcome.action === "deny") throw new Error(`[ai-eng] ${outcome.by}: ${outcome.reason}`);
    },
  };
}
