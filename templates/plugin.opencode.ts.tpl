// ~/.config/opencode/plugins/ai-eng.ts — generated by ai-eng. LOCAL plugin, never a
// remote npm package: OpenCode installs npm plugins with Bun at boot, and
// `"plugin": ["package"]` is arbitrary third-party execution (§13). Import in-process,
// zero spawn, deny = throw.
//
// OpenCode 2.x imports every file in this folder as a plugin ENTRY and takes the module's
// default export as `{ id, setup }`. The chain bundle therefore lives one directory up
// (~/.config/opencode/ai-eng/), where the loader never looks: a bundle here is not a
// plugin, and the load error took the provider config hook down with it.
import { chain } from "../ai-eng/ai-eng-chain.ts";

type ToolCall = { sessionID?: string; id?: string };
type ToolDefinition = {
  /** The registry's own key. Namespaced tools (an MCP tool, `opencode_session_rename`)
   *  have an `id` that differs from the name shown to the model. */
  id?: string;
  name: string;
  execute?: (input: Record<string, unknown>, call: ToolCall) => Promise<unknown>;
};
type ToolRegistry = {
  list: () => ToolDefinition[];
  update: (name: string, change: (definition: ToolDefinition) => void) => void;
};
type PluginContext = {
  tool: { transform: (register: (tools: ToolRegistry) => void) => Promise<unknown> };
  location?: { directory?: string };
};

/** The tool's own output as text: the injection guard's containment arm reads it. */
function textOf(value: unknown): string {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) return value.map(textOf).join("\n");
  if (value !== null && typeof value === "object") {
    const part = value as { text?: unknown };
    if (typeof part.text === "string") return part.text;
    return JSON.stringify(value);
  }
  return String(value ?? "");
}

export default {
  id: "ai-eng",
  setup: async (context: PluginContext): Promise<void> => {
    // The host's own working directory rides along: the gate asks the repo that is
    // actually being worked in, not the one this process happens to sit in.
    const cwd = typeof context.location?.directory === "string" ? context.location.directory : process.cwd();
    await context.tool.transform((tools) => {
      for (const definition of tools.list()) {
        if (typeof definition.execute !== "function") continue;
        const name = definition.name;
        // `update` is keyed by the registry's id, not by the name the model sees.
        tools.update(definition.id ?? name, (tool) => {
          const execute = tool.execute;
          if (typeof execute !== "function") return;
          tool.execute = async (input, call) => {
            const judgement = { tool_name: name, tool_input: input, session_id: call?.sessionID, tool_use_id: call?.id, cwd };
            const before = chain("PreToolUse", judgement, { surface: "opencode" });
            if (before.action === "deny") throw new Error(`[ai-eng] ${before.by}: ${before.reason}`);
            if (before.action === "rewrite" && typeof input["command"] === "string") input["command"] = before.command;
            const result = await execute(input, call);
            const after = chain("PostToolUse", { ...judgement, tool_response: textOf(result) }, { surface: "opencode" });
            if (after.action === "deny") {
              // Containment, not prevention: the tool already ran, so its output is
              // replaced with the reason instead of the injected text reaching the model.
              return { ...(result !== null && typeof result === "object" ? result : {}), content: `[ai-eng] ${after.by}: ${after.reason}` };
            }
            return result;
          };
        });
      }
    });
  },
};
