# Generated by ai-eng init — the CI gate, for Azure Pipelines.
#
# The same gate as .github/workflows/ai-eng-check.yml, and the same rules:
#   · the governor is the *released binary*, pinned by version + sha256, and its
#     provenance is verified before it runs;
#   · every tool is pinned by version + sha256 and no marketplace task is used, so
#     nothing here changes unless this file changes.
#
# Two steps only a person can take in Azure DevOps:
#   1. Pipelines → New pipeline → Azure Repos Git → Existing Azure Pipelines YAML file
#      → .azure-pipelines/ai-eng-check.yml
#   2. Repos → Branches → your default branch → Branch policies → Build validation →
#      add this pipeline, Trigger: Automatic, Policy requirement: Required.
#      Azure Repos ignores a `pr:` block: that branch policy is what runs this
#      pipeline on a pull request and blocks the merge when it fails.

trigger:
  branches:
    include:
      - "*"

# Read only when the repository lives on GitHub or Bitbucket Cloud.
pr:
  branches:
    include:
      - "*"

variables:
  AI_ENG_VERSION: v3.3.1

jobs:
  - job: check
    pool:
      vmImage: ubuntu-latest
    steps:
      - checkout: self

      # Bun from npm into the agent's home: no global prefix to own, no marketplace task.
      - bash: |
          set -euo pipefail
          npm install -g --prefix "$HOME/.local" bun@1.4.4
          echo "##vso[task.prependpath]$HOME/.local/bin"
        displayName: Bun (from npm, version-pinned)

      # The checksum alone proves nothing: binary and manifest come from the same
      # place, so whoever can write one can write both. The attestation binds these
      # bytes to the release workflow that built them. Azure has no GitHub token, so
      # the signed bundle is fetched from GitHub's public API and verified offline:
      # the Sigstore signature, not the download, is what is trusted.
      # ponytail: unauthenticated API, 60 requests an hour per agent IP; add a GitHub
      # token header if shared Microsoft-hosted agents start hitting the limit.
      - bash: |
          set -euo pipefail
          base="https://github.com/arcasilesgroup/ai-engineering/releases/download/${AI_ENG_VERSION}"
          curl -sSfL -o ai-eng "$base/ai-eng-linux-x64"
          curl -sSfL -o CHECKSUMS-SHA256.txt "$base/CHECKSUMS-SHA256.txt"
          awk '$2=="ai-eng-linux-x64"{print $1"  ai-eng"}' CHECKSUMS-SHA256.txt | sha256sum -c -
          command -v gh >/dev/null || { echo "gh (GitHub CLI) is not on this agent: it verifies the governor's provenance"; exit 1; }
          digest="$(sha256sum ai-eng | cut -d' ' -f1)"
          curl -sSfL "https://api.github.com/repos/arcasilesgroup/ai-engineering/attestations/sha256:${digest}" \
            | jq -c '.attestations[].bundle' > ai-eng.sigstore.jsonl
          gh attestation verify ai-eng \
            --bundle ai-eng.sigstore.jsonl \
            --repo arcasilesgroup/ai-engineering \
            --signer-workflow arcasilesgroup/ai-engineering/.github/workflows/release.yml \
            --deny-self-hosted-runners
          # No --source-ref: release.yml is dispatched from the default branch, so the
          # provenance records that branch, never the tag; the version is pinned by
          # the CHECKSUMS-SHA256.txt taken from the release's own assets.
          mkdir -p "$HOME/.local/bin"
          install -m 0755 ai-eng "$HOME/.local/bin/ai-eng"
        displayName: Install the governor (released binary, provenance-verified)

      - bash: ai-eng init --global --yes
        displayName: Install the canon the contract runner reads (machine side, no repo files)

      - bash: |
          set -euo pipefail
          if [ -f bun.lock ] || [ -f bun.lockb ]; then bun install --frozen-lockfile
          elif [ -f package.json ]; then echo "package.json without a bun lockfile — install with your own package manager step"
          else echo "no package.json — the project brings its own runtime"; fi
        displayName: Dependencies (only when the project is a JavaScript one)

      # One step, one rule: run only what the project declares. `bun run --if-present`
      # skips an undeclared script and propagates a declared one's failure — but with
      # no package.json at all it falls through to the shell's own `test` builtin,
      # which exits 1 and reddens a project that declares nothing.
      - bash: |
          set -euo pipefail
          if [ ! -f package.json ]; then echo "no package.json — this project declares no JavaScript checks"; exit 0; fi
          for check in typecheck lint test arch; do
            echo "→ $check"
            bun run --if-present "$check"
          done
        displayName: Project checks — typecheck · lint · test · arch, only when declared

  - job: security
    pool:
      vmImage: ubuntu-latest
    steps:
      - checkout: self

      - bash: |
          set -euo pipefail
          ver=8.30.0
          curl -sSfL -o gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${ver}/gitleaks_${ver}_linux_x64.tar.gz"
          echo "79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e  gitleaks.tgz" | sha256sum -c -
          tar -xzf gitleaks.tgz gitleaks
          ./gitleaks detect --redact -v --no-banner
        displayName: gitleaks (pinned by version + sha256)

      # --config p/ci, never `auto`: auto refuses to run with metrics off, and a
      # governance gate that phones home is not a governance gate. `pipx run` needs no
      # PATH entry for the tool it installs.
      - bash: pipx run --spec semgrep==1.172.0 semgrep scan --error --config p/ci --metrics=off
        displayName: semgrep (pinned, no telemetry)

      - bash: |
          set -euo pipefail
          ver=0.74.0
          curl -sSfL -o trivy.tgz "https://github.com/aquasecurity/trivy/releases/download/v${ver}/trivy_${ver}_Linux-64bit.tar.gz"
          echo "2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a  trivy.tgz" | sha256sum -c -
          tar -xzf trivy.tgz trivy
          ./trivy fs --scanners vuln,misconfig --severity HIGH,CRITICAL --exit-code 1 --quiet .
        displayName: trivy (version + sha256)
